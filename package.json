{
  "name": "dsh-theme-plugin",
  "version": "0.3.2",
  "description": "中国传统色 DeepSeek Harness 主题包 · Chinese traditional color themes for DeepSeek Harness",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "license": "MIT",
  "author": "xiaoxiaodong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nevertoday/dsh-theme-plugin.git"
  },
  "homepage": "https://github.com/nevertoday/dsh-theme-plugin#readme",
  "bugs": "https://github.com/nevertoday/dsh-theme-plugin/issues",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "design-tokens",
    "chinese-traditional-colors",
    "wcag"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "scripts",
    "src/themes.generated.js",
    "src/themes.generated.d.ts",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "immediately": true
    }
  },
  "scripts": {
    "generate": "node scripts/generate-themes.mjs",
    "check": "node scripts/check-contrast.mjs && node scripts/check-readme.mjs",
    "test": "tsx --test test/*.test.ts",
    "build": "tsdown",
    "build:esbuild": "node scripts/build-esbuild.mjs",
    "prepare": "tsdown || node scripts/build-esbuild.mjs",
    "prepublishOnly": "pnpm build && pnpm test && pnpm check"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pinyin-pro": "^3.28.0",
    "tsdown": "^0.11.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-theme": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-theme": {
      "optional": true
    }
  }
}
